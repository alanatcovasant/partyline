# Local dev env (for use with docker-compose Postgres).
# Copy to .env and source before running the app locally.

PGHOST=localhost
PGPORT=5432
PGDATABASE=partyline
PGUSER=partyline
PGPASSWORD=partyline
PGSSLMODE=disable

# Skip Lakebase OAuth credential minting (use password auth instead).
PARTYLINE_LOCAL=true

DATABRICKS_APP_PORT=8000
PARTYLINE_AUTO_MIGRATE=true
PARTYLINE_CLAIM_TTL=900
