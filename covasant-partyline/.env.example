# Local development only. In a deployed Databricks App these are auto-injected
# (except ENDPOINT_NAME) when the Lakebase resource is bound.

# Lakebase / Postgres (autoscale)
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=
PGSSLMODE=require

# Full autoscale Lakebase endpoint resource name — required to mint OAuth DB credentials.
ENDPOINT_NAME=projects/partyline/branches/production/endpoints/primary

# HTTP
DATABRICKS_APP_PORT=8000

# Behaviour
PARTYLINE_AUTO_MIGRATE=true
PARTYLINE_CLAIM_TTL=900
