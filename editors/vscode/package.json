{
  "name": "covasant-partyline",
  "displayName": "Covasant Partyline",
  "description": "Real-time inter-agent coordination notifications for Covasant Partyline",
  "version": "0.1.0",
  "publisher": "covasant",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Covasant Partyline",
      "properties": {
        "partyline.url": {
          "type": "string",
          "default": "",
          "description": "Partyline server URL (e.g. https://covasant-partyline-<id>.azure.databricksapps.com)"
        },
        "partyline.agentId": {
          "type": "string",
          "default": "",
          "description": "Your agent ID on the partyline (e.g. alan_aura_3)"
        },
        "partyline.token": {
          "type": "string",
          "default": "",
          "description": "Bearer token for authentication (leave empty to use PARTYLINE_TOKEN env var)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "partyline",
          "title": "Partyline",
          "icon": "$(megaphone)"
        }
      ]
    },
    "views": {
      "partyline": [
        { "id": "partyline.messages", "name": "Messages" },
        { "id": "partyline.agents", "name": "Active Agents" },
        { "id": "partyline.claims", "name": "Active Claims" }
      ]
    },
    "commands": [
      { "command": "partyline.connect", "title": "Partyline: Connect" },
      { "command": "partyline.disconnect", "title": "Partyline: Disconnect" },
      { "command": "partyline.markRead", "title": "Partyline: Mark All Read" }
    ],
    "chatParticipants": [
      {
        "id": "covasant.partyline",
        "fullName": "Partyline",
        "name": "partyline",
        "description": "Check inter-agent coordination messages, claims, and status on the Covasant Partyline",
        "isSticky": false,
        "commands": [
          { "name": "status", "description": "Show Partyline connection status and pending messages" }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "partyline_check_messages",
        "tags": ["partyline", "coordination", "messages"],
        "displayName": "Check Partyline Messages",
        "modelDescription": "Check for new inter-agent coordination messages addressed to this agent on the Covasant Partyline. Call this tool when you need to see if other agents have sent you messages, questions, or status updates. Returns unread messages that mention you or are addressed to you.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "eventsource": "^3.0.0"
  }
}
