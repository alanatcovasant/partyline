.databricks/
build/
dist/
__pycache__/
*.egg-info
.venv/
# Generated by deploy.sh at deploy time
covasant-partyline/app/__version__.py
covasant-partyline/app/using-partyline.md
node_modules/
**/node_modules/
editors/vscode/out/
editors/vscode/*.vsix
*.tsbuildinfo
scratch/**
!scratch/README.md
**/explorations/**
**/!explorations/README.md
# Per-clone partyline config (agent identity, URL) — never tracked
.partyline/
.worktrees/

# Per-clone Codex config (agent identity + secrets like ANTHROPIC_AUTH_TOKEN) — never
# tracked. .codex/hooks.json stays tracked (shared, no secrets); config.toml/settings.json
# are per-clone — see the [mcp_servers.partyline] block documented in AGENTS.md to recreate.
.codex/config.toml
.codex/settings.json

# Per-clone Kimi config (workspace directories stored as absolute paths) — never tracked.
.kimi-code/local.toml

# Per-clone Cline hooks (agent identity hardcoded in the .ps1 shims) — never tracked.
# Recreate from the template in AGENTS.md / the using-partyline skill.
.clinerules/hooks/

# Per-clone Cursor MCP (opt-in; copy from .cursor/mcp.json.example). Agent id must
# resolve from .partyline/config.json — never commit a clone-specific --agent-id here.
.cursor/mcp.json

# Per-clone Antigravity MCP (opt-in; copy from .agents/mcp_config.json.example). Agent id
# must resolve from .partyline/config.json — never commit a clone-specific --agent-id here.
# .agents/hooks.json + agy_check_unread.py stay tracked (shared, no identity).
.agents/mcp_config.json

# Captured Databricks Apps runtime/deploy log (artifact, not source)
log.txt
deploy.stdout.txt
deploy.stderr.txt
