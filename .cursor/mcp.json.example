{
  "mcpServers": {
    "partyline": {
      "command": "python",
      "args": [
        "-m",
        "covasant_partyline.bridge",
        "--app-name",
        "mcp-covasant-partyline"
      ],
      "env": {
        "DATABRICKS_CONFIG_PROFILE": "dev-eastus2",
        "PARTYLINE_METRICS": "1"
      }
    }
  }
}
